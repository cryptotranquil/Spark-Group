<section class="page-hero page-hero-compact dark-background">
  <div class="container">
    <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a><span aria-hidden="true"> / </span><span aria-current="page">Contact</span></nav>
    <h1>Contact us</h1>
    <p class="page-hero-lead">Call, email or send an enquiry. Tell us which division you need and we will route it to the right team.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row gy-5">
      <div class="col-lg-5">
        <% site.offices.forEach(function (o) { %>
        <h2 class="h4"><%= o.city %> office</h2>
        <address><% o.lines.forEach(function (l) { %><div><%= l %></div><% }); %></address>
        <% }); %>
        <p class="mb-1">
          <% site.phones.forEach(function (p) { %><span class="d-block"><%= p.label %>: <a href="tel:<%= p.tel %>"><%= p.display %></a></span><% }); %>
        </p>
        <p>Email: <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      </div>

      <div class="col-lg-7">
        <div id="form-status" role="status" aria-live="polite">
          <% if (result) { %><div class="alert <%= result.ok ? 'alert-success' : 'alert-danger' %>"><%= result.message %></div><% } %>
        </div>
        <form id="contact-form" class="contact-form" action="/contact" method="post" novalidate>
          <div class="mb-3">
            <label for="name" class="form-label">Your name</label>
            <input id="name" name="name" type="text" class="form-control<%= form.errors.name ? ' is-invalid' : '' %>" autocomplete="name" required value="<%= form.values.name || '' %>"<%- form.errors.name ? ' aria-describedby="name-error"' : '' %>>
            <div id="name-error" class="invalid-feedback"><%= form.errors.name || '' %></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="email" class="form-label">Email</label>
              <input id="email" name="email" type="email" class="form-control<%= form.errors.email ? ' is-invalid' : '' %>" autocomplete="email" required value="<%= form.values.email || '' %>"<%- form.errors.email ? ' aria-describedby="email-error"' : '' %>>
              <div id="email-error" class="invalid-feedback"><%= form.errors.email || '' %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label for="phone" class="form-label">Phone (optional)</label>
              <input id="phone" name="phone" type="tel" class="form-control" autocomplete="tel" value="<%= form.values.phone || '' %>">
            </div>
          </div>
          <div class="mb-3">
            <label for="division" class="form-label">What is this about?</label>
            <select id="division" name="division" class="form-select">
              <option value="">General enquiry</option>
              <% site.divisions.forEach(function (d) { %><option value="<%= d.slug %>"<%- form.values.division === d.slug ? ' selected' : '' %>><%= d.name %></option><% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" rows="6" class="form-control<%= form.errors.message ? ' is-invalid' : '' %>" required<%- form.errors.message ? ' aria-describedby="message-error"' : '' %>><%= form.values.message || '' %></textarea>
            <div id="message-error" class="invalid-feedback"><%= form.errors.message || '' %></div>
          </div>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off"></label></div>
          <button type="submit" class="btn-spark btn-spark-solid">Send message</button>
        </form>
      </div>
    </div>
  </div>
</section>
