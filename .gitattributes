# Normalize line endings for text files
* text=auto eol=crlf
*.js text eol=crlf
*.css text eol=crlf
*.ejs text eol=crlf
*.html text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Node modules
node_modules binary